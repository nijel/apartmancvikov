msgstr "Im Sommer 7–18 Uhr."

#: apartmancvikov/content.py
msgid "Dítě 30 Kč, dospělý 50 Kč."
msgstr "Kind 30 CZK, Erwachsene 50 CZK."

#: apartmancvikov/content.py
