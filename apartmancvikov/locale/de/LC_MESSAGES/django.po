msgstr "Eine kurze, aber anspruchsvolle Tour rund um den Klíč."

#: apartmancvikov/content.py
msgid "Vystoupejte k Milštejnu a horské nádrži Naděje."
msgstr "Fahren Sie hinauf nach Milštejn und zum Bergstausee Naděje."

#: apartmancvikov/content.py
msgid "Na Novou Huť"
msgstr "Nach Nová Huť"

#: apartmancvikov/content.py
msgid "Okruh Lužickými lesy na Novou Huť s návratem přes Rousínov."
msgstr "Eine Runde durch die Lausitzer Wälder nach Nová Huť und über Rousínov zurück."

#: apartmancvikov/content.py
msgid "Okruh přes Kunratice"
msgstr "Radrunde über Kunratice"

#: apartmancvikov/content.py
msgid "Nenáročná projížďka do Kunratic u Cvikova."
msgstr "Eine leichte Tour nach Kunratice u Cvikova."

