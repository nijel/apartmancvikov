#: apartmancvikov/templates/index.html:5
msgid "Rodinný apartmán ve Cvikově pro 7 až 9 hostů"
msgstr "Family apartment in Cvikov for 7 to 9 guests"

#: apartmancvikov/templates/index.html:9
msgid ""
"Prostorný rodinný apartmán o ploše 180 m² ve Cvikově se 3 ložnicemi, 2 "
"koupelnami, zahradou, bazénem a vybavením pro děti."
msgstr ""
"Spacious 180 m² family apartment in Cvikov with 3 bedrooms, 2 bathrooms, a "
"garden, pool and children's equipment."

#: apartmancvikov/templates/index.html:19
msgid ""
"Prostorný apartmán o ploše 180 m² se třemi ložnicemi, sedmi standardními "
"lůžky a dvěma dalšími místy na matracích."
msgstr ""
"Spacious 180 m² apartment with three bedrooms, seven standard beds and two "
"additional sleeping places on floor mattresses."

#: apartmancvikov/templates/index.html:26
msgid "Rodinná dovolená"
msgstr "Family holiday"

#: apartmancvikov/templates/index.html:29
msgid "Ubytování v apartmánu"
msgstr "Accommodation in the apartment"

