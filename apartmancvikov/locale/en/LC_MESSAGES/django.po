msgid "Co cena zahrnuje?"
msgstr "What does the price include?"

msgid "Ubytování ve třech útulných pokojích se společnou koupelnou."
msgstr "Accommodation in three cozy rooms with a shared bathroom."

msgid "Na pokojích jsou připraveny osušky a ručníky."
msgstr "Towels are provided in the rooms."

msgid "Parkování přímo u apartmánu"
msgstr "Parking directly at the apartment"

msgid "Využití dětského koutku i venkovních atrakcí"
msgstr "Use of children's corner and outdoor attractions"

msgid "Možnost využít dětského vybavení"
