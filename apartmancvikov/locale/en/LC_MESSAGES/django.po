#: apartmancvikov/templates/cenik.html:47
msgid "Ubytování v útulných pokojích se společnou koupelnou."
msgstr "Accommodation in cozy rooms with a shared bathroom."

#: apartmancvikov/templates/cenik.html:48
msgid "Na pokojích jsou připraveny osušky a ručníky."
msgstr "Towels are provided in the rooms."

#: apartmancvikov/templates/cenik.html:49
